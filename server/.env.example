# Copie para server/.env e preencha. Em produção, estas variáveis ficam no serviço "web" do Railway.

# PostgreSQL (obrigatório)
# Local: URL pública do Postgres do Railway -> railway variables --service Postgres (DATABASE_PUBLIC_URL)
# Railway: ${{Postgres.DATABASE_URL}} (rede interna)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:PORTA/railway"

# Chave para assinar os tokens de login (obrigatório). Gere com: openssl rand -hex 32
JWT_SECRET=""

# Origens permitidas no CORS, separadas por vírgula (obrigatório em produção)
CLIENT_ORIGIN="http://localhost:5173"

# Porta da API (o Railway define automaticamente)
PORT=3001

# Admin inicial criado pelo seed (só na primeira execução, se o e-mail ainda não existir)
ADMIN_EMAIL="admin@hospedalink.com.br"
# Obrigatória para o primeiro seed, mínimo de 12 caracteres
ADMIN_PASSWORD=""
